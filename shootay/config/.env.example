# Copy to shootay/.env — never commit the real file, never ship these values to the client.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://shootay:CHANGE_ME@localhost:5432/shootay
# Set to true for managed Postgres that requires TLS (Render, Neon, Supabase, RDS...)
DATABASE_SSL=false
# 32+ random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Public origin used for invite links, e.g. https://play.example.com (optional: defaults to the browser's origin)
PUBLIC_URL=
# Only needed when the client is hosted on a different origin than the server (comma separated)
CORS_ORIGINS=
